{
  "manifest_version": 3,
  "name": "Cognigy Graphite",
  "version": "0.14.100",
  "description": "Graphite colours for Cognigy, preserving native layout, images and depth.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://trial.cognigy.ai/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cognigy Graphite",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://trial.cognigy.ai/*"
      ],
      "js": [
        "sites.js",
        "bootstrap.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
